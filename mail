#!/usr/bin/env bash
# One command for everything. Run it from this folder on your own computer:  ./mail help
set -euo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)

usage() {
  cat <<'EOF'
Usage: ./mail <command>

Set up (in this order the first time)
  init                         create mail.conf from the example, then edit it
  server-setup                 prepare a fresh server: Docker, firewall, swap, SSH keys only
  deploy                       install or update the mail server (safe to run again)
  add <address>                create a mailbox; prints its password once
  dns records                  the DNS records to create, with exact values
  dns check                    check those records on public DNS
  test <address> [--external you@gmail.com]   end-to-end test of the server

Mailboxes
  add <address>                new mailbox
  passwd <address>             new password for a mailbox
  del <address>                delete a mailbox and all its mail
  alias <from> <to>            forward <from> to <to>
  unalias <from> <to>          remove that forward
  list                         mailboxes and aliases
  outlook <address>            settings to type into Outlook / any mail app

Console, REST API and MCP  (https://MAIL_HOST)
  app-admin <email>            create an admin login for the console; prints a temporary password
  app-link <address>           let the console use an existing mailbox (password from SECRETS_DIR)
  app-reset-two-step <email>   remove two-step verification from a login (lost phone)
  app-unblock <ip>             clear the failed sign-in limit for a network address
  app-test                     run the console/API/MCP/OAuth test suite against the server
  app-test-claude              let Claude Code use the MCP server for real, then check its work

Running it
  status                       services, mail queue, disk, certificate
  logs                         follow the mail log (Ctrl+C to stop)
  queue                        mail waiting to be sent;  queue flush  retries it now
  backup                       make a backup now (one is made every night)
  unban <ip>                   unblock an address banned after wrong passwords
  ssh                          open a shell on the server

DNS automation (GoDaddy only; other providers: use `dns records` and set them by hand)
  dns prepare | spf | switch | rollback | show
EOF
}

cmd=${1:-help}
[[ $# -gt 0 ]] && shift

if [[ $cmd == init ]]; then
  if [[ -f $HERE/mail.conf ]]; then echo "mail.conf already exists"; else
    cp "$HERE/mail.conf.example" "$HERE/mail.conf" && echo "created mail.conf: open it and fill in your values"
  fi
  exit 0
fi
if [[ $cmd == help || $cmd == -h || $cmd == --help ]]; then usage; exit 0; fi

source "$HERE/scripts/common.sh"

case "$cmd" in
  server-setup)
    remote "MAIL_HOST='$MAIL_HOST' SERVER_IP='$SERVER_IP' bash -s" < "$HERE/scripts/server-setup.sh" ;;
  deploy)
    "$HERE/scripts/deploy.sh" ;;
  add|passwd|del|alias|unalias|list)
    "$HERE/scripts/account.sh" "$cmd" "$@" ;;
  outlook)
    a=${1:?give the address, e.g. ./mail outlook you@$DOMAIN}
    cat <<EOF
Account type ........ IMAP
Email / user name ... $a
Password ............ $( [[ -f $SECRETS_DIR/$a.txt ]] && echo "in $SECRETS_DIR/$a.txt" || echo "the one you set")
Incoming (IMAP) ..... $MAIL_HOST   port 993   SSL/TLS
Outgoing (SMTP) ..... $MAIL_HOST   port 465   SSL/TLS   (or 587 with STARTTLS)
Outgoing sign-in .... yes, same user name and password
EOF
    ;;
  dns)
    python3 "$HERE/scripts/dns.py" "${1:-}" ;;
  test)
    a=${1:?give the mailbox to test with, e.g. ./mail test you@$DOMAIN}; shift
    MAIL_USER=$a python3 "$HERE/tests/check.py" "$@" ;;
  status)
    remote "cd '$REMOTE_DIR' && docker compose ps --format '{{.Name}}: {{.Status}}' && echo &&
      docker exec mailserver supervisorctl status | awk '{print \$1\": \"\$2}' | grep -v STOPPED && echo &&
      docker exec mailserver postqueue -p | tail -1 && df -h / | awk 'NR==2{print \"disk: \"\$3\" used, \"\$4\" free\"}' &&
      openssl x509 -enddate -noout -in data/certs/$MAIL_HOST.crt" ;;
  logs)
    remote "docker exec mailserver tail -f /var/log/mail/mail.log" ;;
  queue)
    if [[ ${1:-} == flush ]]; then remote "docker exec mailserver postqueue -f" && echo "retrying now"
    else remote "docker exec mailserver postqueue -p"; fi ;;
  backup)
    remote "cd '$REMOTE_DIR' && scripts/backup.sh" ;;
  unban)
    ip=${1:?give the IP address}
    for j in dovecot postfix custom; do remote "docker exec mailserver fail2ban-client set $j unbanip $ip" 2>/dev/null || true; done
    echo "unbanned $ip" ;;
  app-admin)
    remote "docker exec mailapp python -m mailapp.cli create-admin '${1:?give the admin email}'" ;;
  app-link)
    a=${1:?give the mailbox address}
    [[ -f $SECRETS_DIR/$a.txt ]] || { echo "no saved password in $SECRETS_DIR/$a.txt" >&2; exit 1; }
    remote "docker exec -i mailapp python -m mailapp.cli link-mailbox '$a'" < "$SECRETS_DIR/$a.txt" ;;
  app-unblock)
    remote "docker exec mailapp python -m mailapp.cli unblock-ip '${1:?give the IP address}'" ;;
  app-test|app-test-claude)
    venv=$HERE/.venv-test
    # the suite fails sign-ins on purpose; start each run with a clean limit for this network
    myip=$(curl -s -m 10 https://api.ipify.org || true)
    [[ -n $myip ]] && remote "docker exec mailapp python -m mailapp.cli unblock-ip '$myip'" >/dev/null
    [[ -x $venv/bin/python ]] || { python3 -m venv "$venv" && "$venv/bin/pip" -q install -r "$HERE/app/tests/requirements.txt"; }
    # a throwaway admin whose login is also a mailbox, so the tests can read its emailed sign-in codes
    who="e2e-admin-$(openssl rand -hex 3)@$DOMAIN"
    "$HERE/scripts/account.sh" add "$who" >/dev/null
    out=$(remote "docker exec mailapp python -m mailapp.cli create-admin '$who'")
    pw=$(sed -n 's/^temporary password: //p' <<<"$out")
    status=0
    BASE_URL="https://$MAIL_HOST" DOMAIN="$DOMAIN" ADMIN_EMAIL="$who" ADMIN_PASSWORD="$pw" \
      ADMIN_MAILBOX_PASSWORD="$(cat "$SECRETS_DIR/$who.txt")" \
      bash -c 'if [[ $0 == app-test ]]; then exec "$1/bin/python" -m pytest -q "$2/app/tests/test_live.py" "${@:3}";
               else exec "$1/bin/python" "$2/app/tests/claude_check.py"; fi' "$cmd" "$venv" "$HERE" "$@" || status=$?
    remote "docker exec mailapp python -m mailapp.cli delete-user '$who'" >/dev/null
    dms email del -y "$who" >/dev/null 2>&1; rm -f "$SECRETS_DIR/$who.txt"
    exit $status ;;
  app-reset-two-step)
    remote "docker exec mailapp python -m mailapp.cli reset-two-step '${1:?give the email}'" ;;
  ssh)
    ssh "${SSH_OPTS[@]/BatchMode=yes/BatchMode=no}" -t "$SSH_TARGET" "cd '$REMOTE_DIR'; exec bash -l" ;;
  *)
    usage; exit 1 ;;
esac
