# Overrides for docker-mailserver's fail2ban (6 failed logins => banned).
# `./mail deploy` copies this into the server's config, replacing SERVER_IP.
[DEFAULT]
# Never banned: localhost, the server itself (tests can run from it) and the console app,
# which only uses stored mailbox passwords and has its own sign-in limits.
ignoreip = 127.0.0.1/8 SERVER_IP 172.31.250.10
# A ban lasts one day, so a mistyped password in a mail app doesn't lock you out for a week.
bantime = 1d
findtime = 1h
maxretry = 6
