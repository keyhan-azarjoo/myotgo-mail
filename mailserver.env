# docker-mailserver settings shared by every install. No secrets and nothing domain-specific
# here: the host name, domain and certificate paths come from compose.yaml.
# All options: https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/
LOG_LEVEL=info
ACCOUNT_PROVISIONER=FILE
SSL_TYPE=manual

# Spam filtering and DKIM signing: rspamd only (light). No antivirus: it needs ~1.5 GB RAM.
ENABLE_RSPAMD=1
RSPAMD_GREYLISTING=0
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_AMAVIS=0
ENABLE_CLAMAV=0
ENABLE_SPAMASSASSIN=0
MOVE_SPAM_TO_JUNK=1

# Safety: every sender must sign in, and may only send as their own address/aliases
PERMIT_DOCKER=none
SPOOF_PROTECTION=1
ENABLE_FAIL2BAN=1

ENABLE_POP3=0
ENABLE_IMAP=1
ENABLE_MANAGESIEVE=0
ENABLE_QUOTAS=1
POSTFIX_MESSAGE_SIZE_LIMIT=36700160

# Outgoing mail goes straight to the recipient's server on port 25.
# If your host blocks port 25 for good, put a relay here, e.g. [smtp.relay.example]:587
DEFAULT_RELAY_HOST=
